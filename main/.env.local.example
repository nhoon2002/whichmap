# WhichMap Environment Variables
# Copy this file to .env.local and fill in your actual values

# ============================================
# Firebase Configuration (Client-side)
# ============================================
# Get these from Firebase Console > Project Settings > General
# https://console.firebase.google.com/project/whichmap-eb2aa/settings/general

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=whichmap-eb2aa.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=whichmap-eb2aa
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=whichmap-eb2aa.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# ============================================
# Google Maps API (Server-side only)
# ============================================
# Get this from Google Cloud Console > APIs & Services > Credentials
# https://console.cloud.google.com/apis/credentials
# Required APIs: Routes API (v2), Geocoding API

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ============================================
# Apple Maps Server API (Server-side)
# ============================================
# Get these from Apple Developer Console: https://developer.apple.com/account/resources/authkeys/list
# 1. Create a Maps ID: https://developer.apple.com/account/resources/identifiers/list
# 2. Create an API Key with MapKit JS enabled
# 3. Download the .p8 private key file (you can only download once!)

# Team ID (10 characters) - Found in top-right of Apple Developer Console
APPLE_MAPS_TEAM_ID=ABC1234DEF

# Key ID (10 characters) - From the API key you created
APPLE_MAPS_KEY_ID=XYZ9876WVU

# Private Key - Paste the entire contents of your .p8 file here
# Include the BEGIN and END lines, replace newlines with \n
APPLE_MAPS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyContentHere\nMoreKeyContent\n-----END PRIVATE KEY-----"

# ============================================
# Rate Limiting (Optional - Production)
# ============================================
# For production, use Upstash Redis for distributed rate limiting
# Get these from Upstash Console: https://console.upstash.com/
# If not set, will use in-memory rate limiting (development only)

# UPSTASH_REDIS_REST_URL=your_upstash_redis_url_here
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# ============================================
# API Key Authentication (Future - Monetization)
# ============================================
# For future API key-based authentication and billing

# API_KEY_SALT=your_random_salt_for_api_key_hashing
# STRIPE_SECRET_KEY=your_stripe_secret_key_here
# STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# ============================================
# Analytics & Monitoring (Optional)
# ============================================

# Google Analytics 4 (GA4) Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=YOUR_KEY
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_vercel_analytics_id
# SENTRY_DSN=your_sentry_dsn_here
# SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# ============================================
# Development Settings
# ============================================

# Set to 'development' for local dev, 'production' for deployed
NODE_ENV=development

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can only read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Search History Collection
    // Users can only read/write their own search history
    match /search_history/{historyId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Tracking Events Collection (search events for analytics)
    match /tracking_events/{eventId} {
      // Anyone can create tracking events (including anonymous users)
      allow create: if true;
      
      // Read access for analytics (restrict to admin in production)
      allow read: if true;
      
      // No updates needed - events are immutable
      allow update: if false;
    }
    
    // Tracking Clicks Collection (click events for commission attribution)
    match /tracking_clicks/{clickId} {
      // Anyone can create click events (including anonymous users)
      allow create: if true;
      
      // Read access for analytics (restrict to admin in production)
      allow read: if true;
      
      // No updates or deletes - clicks are immutable
      allow update, delete: if false;
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

